# Copia este archivo como .env para correr en local.
# El .env NO se sube a git (ver .gitignore). En Render, estas mismas
# variables se configuran en Environment.

# ------------------------------------------------------------------ modelos
# Detector, de más rápido a más preciso:
#   yolo-v9-t-256-license-plate-end2end
#   yolo-v9-t-384-license-plate-end2end
#   yolo-v9-t-512-license-plate-end2end   <- default, buen balance
#   yolo-v9-t-640-license-plate-end2end
#   yolo-v9-s-608-license-plate-end2end   <- el más preciso, el más lento
DETECTOR_MODEL=yolo-v9-t-512-license-plate-end2end

# OCR:
#   cct-xs-v2-global-model    (el más rápido)
#   cct-s-v2-global-model     <- default, más preciso
#   global-plates-mobile-vit-v2-model
#   european-plates-mobile-vit-v2-model
#   argentinian-plates-cnn-model
OCR_MODEL=cct-s-v2-global-model

# Por debajo de esto el detector ni reporta la caja
DETECTOR_CONF_THRESH=0.4

# cpu | cuda | auto
OCR_DEVICE=cpu

# ---------------------------------------------------------------- decisiones
# Si el carácter MÁS DÉBIL de la placa baja de esto, se intenta el fallback.
# Súbelo para ser más exigente (más llamadas a Groq), bájalo para el contrario.
UMBRAL_CONFIANZA=0.85

# ------------------------------------------------------------------- entrada
# Tamaño máximo de la imagen subida, en MB
MAX_MB_IMAGEN=10
# Píxeles de contexto alrededor de la placa en el recorte que se devuelve
MARGEN_RECORTE=12

# ----------------------------------------------------------------- seguridad
# Si la defines, POST /detect exige el header X-API-Key con este valor.
# Vacía = sin autenticación: cómodo en local, mala idea en internet.
API_KEY=
# Dominios que pueden llamar a la API desde un navegador, separados por coma.
# * = cualquiera. Ejemplo: https://miapp.com,https://www.miapp.com
CORS_ORIGENES=*

# ------------------------------------------------------------ Groq (opcional)
# Si lo activas, pon también API_KEY: cada consulta gasta cuota de tu cuenta.
GROQ_HABILITADO=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MODEL_RESPALDO=qwen/qwen3.8-27b
GROQ_TIMEOUT=8.0

# ---------------------------------------------------- Google Drive (opcional)
# Vigila una carpeta y lee la placa de cada foto nueva. Ver el README.
DRIVE_HABILITADO=false
# Lo que va después de /folders/ en la URL de la carpeta
DRIVE_CARPETA_ID=
# Credenciales de la service account. Usa UNA de las dos:
#   la ruta al JSON (relativa a esta carpeta), cómodo en local
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
#   o el JSON completo en una sola línea, cómodo en Render
GOOGLE_SERVICE_ACCOUNT_JSON=
# URL pública HTTPS de la API (ej. la de ngrok en local). Google manda los
# avisos a {URL_PUBLICA}/drive/webhook. En Render no hace falta: se usa
# RENDER_EXTERNAL_URL. Vacía = sin webhook, solo la revisión periódica.
URL_PUBLICA=
# Cada cuántos segundos se revisa la carpeta aunque no llegue ningún aviso
DRIVE_INTERVALO_REVISION=600
